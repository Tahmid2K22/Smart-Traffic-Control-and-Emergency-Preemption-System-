// TRAFFIC-ONLY RULES FRAGMENT / ISOLATED EMULATOR RULESET — MERGE BEFORE DEPLOY.
// Deploying this standalone file REPLACES the database's entire live ruleset.
// Export/review existing live rules and merge deliberately; do not deploy as-is.
// Overlapping allow grants are ORed: broad existing grants can bypass ALL of
// these restrictions, including users profile integrity. See test/firebase_rules/README.md.
// No client may write users/intersections here; provision via trusted Admin SDK.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function officer(intersectionId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'traffic_police'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'APPROVED'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedIntersectionId == intersectionId
        && exists(/databases/$(database)/documents/intersections/$(intersectionId))
        && get(/databases/$(database)/documents/intersections/$(intersectionId)).data.isActive == true;
    }

    function boundDevice(controller) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && controller.deviceUid is string
        && request.auth.uid == controller.deviceUid;
    }

    function device(intersectionId) {
      return exists(/databases/$(database)/documents/trafficControllers/$(intersectionId))
        && boundDevice(get(/databases/$(database)/documents/trafficControllers/$(intersectionId)).data);
    }

    function boundedString(value, maxBytes) {
      return value is string && value.toUtf8().size() <= maxBytes;
    }

    match /trafficControllers/{intersectionId} {
      allow read: if boundDevice(resource.data) || officer(intersectionId);
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['deviceUid'])
        && request.resource.data.deviceUid is string
        && request.resource.data.deviceUid.size() > 0;
      allow update: if (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceUid'])
          && request.resource.data.deviceUid is string
          && request.resource.data.deviceUid.size() > 0)
        || (boundDevice(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['statusJson', 'reportedAt', 'sampledAt', 'transport', 'blePriority'])
          && request.resource.data.keys()
            .hasOnly(['deviceUid', 'statusJson', 'reportedAt', 'sampledAt', 'transport', 'blePriority'])
          && boundedString(request.resource.data.statusJson, 511)
          && request.resource.data.reportedAt is timestamp
          && request.resource.data.reportedAt == request.time
          && request.resource.data.sampledAt is timestamp
          && request.resource.data.sampledAt <= request.time + duration.value(2, 's')
          && request.resource.data.sampledAt >= request.time - duration.value(6, 's')
          && request.resource.data.transport in ['ble', 'firebase', 'idle']
          && request.resource.data.blePriority is bool);
      allow delete: if admin();

      match /commands/{commandId} {
        function validPayload(p) {
          let base = ['v', 'cmd', 'request_id', 'intersection', 'uid', 'role'];
          return p is map
            && p.keys().hasAll(base)
            && p.v is int && p.v == 2
            && p.request_id == commandId
            && p.intersection == intersectionId
            && p.uid == request.auth.uid
            && p.role == 'traffic_police'
            && ((p.cmd == 'SET'
                && p.keys().hasOnly(base.concat(['direction', 'light']))
                && p.direction in ['north', 'east', 'south', 'west']
                && p.light in ['red', 'yellow', 'green'])
              || (p.cmd == 'AUTO'
                && p.keys().hasOnly(base.concat(['green_sec', 'yellow_sec', 'all_red_sec']))
                && p.green_sec is int && p.green_sec >= 5 && p.green_sec <= 300
                && p.yellow_sec is int && p.yellow_sec >= 3 && p.yellow_sec <= 60
                && p.all_red_sec is int && p.all_red_sec >= 2 && p.all_red_sec <= 60)
              || (p.cmd in ['ALL_RED', 'MANUAL', 'STATUS']
                && p.keys().hasOnly(base)));
        }

        function validCommand() {
          let data = request.resource.data;
          let controller = get(/databases/$(database)/documents/trafficControllers/$(intersectionId));
          return commandId.matches('^[A-Za-z0-9_-]{1,32}$')
            && intersectionId != 'UNCONFIGURED'
            && controller.data.deviceUid is string && controller.data.deviceUid.size() > 0
            && data.keys().hasOnly(['state', 'createdAt', 'expiresAt', 'payload'])
            && data.state == 'pending'
            && data.createdAt is timestamp && data.createdAt == request.time
            && data.expiresAt is timestamp && data.expiresAt > request.time
            && data.expiresAt <= request.time + duration.value(20, 's')
            && validPayload(data.payload);
        }

        function validAck() {
          let data = request.resource.data;
          let changed = data.diff(resource.data).affectedKeys();
          return resource.data.state == 'pending'
            && changed.hasOnly(['state', 'error', 'ackJson'])
            && changed.hasAll(['state', 'error', 'ackJson'])
            && boundedString(data.error, 64)
            && boundedString(data.ackJson, 511)
            && ((data.state == 'accepted' && data.error == '')
              || (data.state == 'rejected' && data.error.size() > 0));
        }

        function identicalTerminalAck() {
          // A lost HTTP response may cause the firmware to resend its cached ACK.
          return resource.data.state in ['accepted', 'rejected']
            && request.resource.data == resource.data;
        }

        // Bound collection queries work, including firmware's state=pending,
        // limit=1 query. No per-command submitter lookup: rules are not filters.
        // Creation checks authority; firmware must enforce expiresAt on fetch.
        allow read: if device(intersectionId) || officer(intersectionId);
        allow create: if officer(intersectionId) && validCommand();
        allow update: if device(intersectionId) && (validAck() || identicalTerminalAck());
        // No client deletes or officer updates, even for pending commands.
      }
    }

    // Standalone default deny: also denies users/intersections reads and writes.
    // Rule helper get()/exists() calls do not require client read permission.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
